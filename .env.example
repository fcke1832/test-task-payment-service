# PostgreSQL (для локального запуска; docker-compose переопределяет host/port)
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=payment_db
POSTGRES_ECHO=false

# Хост-порт PostgreSQL в docker-compose
POSTGRES_HOST_PORT=5433

# RabbitMQ
RABBITMQ_DEFAULT_USER=payments
RABBITMQ_DEFAULT_PASS=payments_password
RABBITMQ_URL=amqp://payments:payments_password@localhost:5672/

# Dozzle (просмотр логов контейнеров)
DOZZLE_PORT=8080

# Приложение
APP_ENV=development
API_KEY=test-api-key-123

# Outbox relay
OUTBOX_POLL_INTERVAL=1.0
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_BACKOFF_SECONDS=60

# Consumer
MAX_PROCESSING_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=1.0
PAYMENT_SUCCESS_RATE=0.9
PROCESSING_MIN_SECONDS=2.0
PROCESSING_MAX_SECONDS=5.0
WEBHOOK_TIMEOUT_SECONDS=10.0
